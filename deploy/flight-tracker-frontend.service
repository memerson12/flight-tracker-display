[Unit]
Description=Flight Tracker Frontend
After=flight-tracker-backend.service network-online.target
Wants=flight-tracker-backend.service network-online.target

[Service]
Type=simple
User=memerson
WorkingDirectory=/home/memerson/flight-tracker-display
Environment=NODE_ENV=production
ExecStart=/usr/bin/env pnpm preview --host 0.0.0.0 --port 8080 --strictPort
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
