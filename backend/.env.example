ADMIN_PASSWORD=replace-with-a-long-random-password
# Admin sessions expire after 8 hours by default. Set this to true only when
# the app is served over HTTPS.
ADMIN_SESSION_TTL_MS=28800000
ADMIN_COOKIE_SECURE=false
PORT=8000
FLIGHT_PROVIDER=flightradar24
# Comma-separated origins permitted to make direct cross-origin API requests.
# Same-origin access through the application does not require this setting.
ALLOWED_ORIGINS=
# Optional runtime storage overrides. Defaults are backend/data and backend/photos.
FLIGHT_TRACKER_DATA_DIR=
PHOTO_STORAGE_DIR=
PHOTO_DB_PATH=
CONFIG_PATH=
MAX_PHOTO_SIZE=26214400
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
MAPBOX_TOKEN=
